# ============================================================
# pr-agent · 环境变量模板
# 复制本文件为 .env 并填入真实值即可。
# .env 已被 .gitignore 忽略,密钥不会提交到仓库。
# ============================================================

# ---------- LLM 接入(OpenAI 兼容中转站 / relay) ----------
# 复制本段到 .env,把下面四项填好,端到端即可跑通。

# 自定义 provider 名:任意字符串,仅作标识(默认 relay)
LLM_PROVIDER=relay

# 中转站提供的模型名,例如 gpt-5 / gpt-4o / deepseek-chat / claude-3-5-sonnet 等
LLM_MODEL=gpt-5

# 中转站 base URL,必须包含到 /v1 这一级
# 例: https://your-relay.example.com/v1
LLM_BASE_URL=

# 中转站 API Key
LLM_API_KEY=

# ---------- Mastra 存储库路径(可选) ----------
# LibSQL 存储文件绝对路径;默认项目根 mastra.db
# MASTRA_DB_PATH=./mastra.db

# ---------- 飞书通知(Feishu/Lark adapter) ----------
# workflow 的 notify 步会向飞书推「开发完成」卡片。两种接入方式任选其一:
#
# 方式 A · 群机器人 Webhook(最简单,推荐先用来验证连通性):
#   飞书群 → 设置 → 群机器人 → 添加机器人,复制 Webhook 地址填下面。
FEISHU_WEBHOOK_URL=
# 可选:群机器人开启「签名校验」时,把签名密钥填这里(不填则发无签名消息)。
# FEISHU_WEBHOOK_SECRET=
#
# 方式 B · 企业自建应用(可发到指定群/人,卡片按钮支持回调):
#   飞书开放平台 → 企业自建应用 → 启用机器人能力,拿到 App ID / App Secret。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 接收目标 ID:群的 chat_id 或 用户的 open_id(取决于下面的类型)。
# FEISHU_RECEIVE_ID=
# 接收 ID 类型:chat_id(群) | open_id(用户) | user_id | union_id,默认 chat_id。
# FEISHU_RECEIVE_ID_TYPE=chat_id
#
# 验证:`node scripts/verify-feishu.js`(结构部分随时可跑;填好凭据后发真实测试卡片)

# ---------- GitHub(K6 adapter:checkout / commit / push-open-pr) ----------
# workflow 的 checkout 步用本地 git 建分支,push-open-pr 步用 git push + gh pr create 开 PR。
# 鉴权二选一(任意一种即可,owner/repo 留空会自动从 `git remote get-url origin` 解析):
#
# 方案 A(推荐,免建 token):本机终端跑 `gh auth login`(浏览器授权) → `gh auth setup-git`,
#   此后 git push 自动走 OAuth 凭证,adapter 自动探测到 gh 登录态。本段 GITHUB_TOKEN 留空即可。
#
# 方案 B(手动建 token):GitHub → 右上角头像 → Settings → 左侧栏最底部 Developer settings →
#   Personal access tokens → Tokens (classic) 或 Fine-grained tokens,作用域勾选 repo(含 public_repo),
#   把生成的 token 填到下面。适合 CI / 服务器侧(无交互浏览器)。
GITHUB_TOKEN=
# 目标仓库 owner(组织名 / 用户名);留空自动从 git remote 解析(当前仓库 = wintim1143)
# GITHUB_OWNER=
# 目标仓库名;留空自动从 git remote 解析(当前仓库 = pr-agent)
# GITHUB_REPO=
# PR 目标基础分支(默认 main)
# GITHUB_BASE_BRANCH=main
# gh 可执行文件路径;默认自动探测(Windows 通常在 C:\Program Files\GitHub CLI\gh.exe),一般无需设
# GH_PATH=
#
# 验证:`node scripts/verify-github.js`(缺失配置会提示去哪获取;齐全则跑 `gh auth status` 确认鉴权,不开真实 PR)
