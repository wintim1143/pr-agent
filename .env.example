# ============================================================
# pr-agent · 环境变量模板
# 复制本文件为 .env 并填入真实值即可。
# .env 已被 .gitignore 忽略,密钥不会提交到仓库。
# ============================================================

# ---------- LLM 接入(OpenAI 兼容中转站 / relay) ----------
# 复制本段到 .env,把下面四项填好,端到端即可跑通。

# 自定义 provider 名:任意字符串,仅作标识(默认 relay)
LLM_PROVIDER=relay

# 中转站提供的模型名,例如 gpt-5 / gpt-4o / deepseek-chat / claude-3-5-sonnet 等
LLM_MODEL=gpt-5

# 中转站 base URL,必须包含到 /v1 这一级
# 例: https://your-relay.example.com/v1
LLM_BASE_URL=

# 中转站 API Key
LLM_API_KEY=

# ---------- Mastra 存储库路径(可选) ----------
# LibSQL 存储文件绝对路径;默认项目根 mastra.db
# MASTRA_DB_PATH=./mastra.db

# ---------- 飞书通知(Feishu/Lark adapter) ----------
# workflow 的 notify 步会向飞书推「开发完成」卡片。两种接入方式任选其一:
#
# 方式 A · 群机器人 Webhook(最简单,推荐先用来验证连通性):
#   飞书群 → 设置 → 群机器人 → 添加机器人,复制 Webhook 地址填下面。
FEISHU_WEBHOOK_URL=
# 可选:群机器人开启「签名校验」时,把签名密钥填这里(不填则发无签名消息)。
# FEISHU_WEBHOOK_SECRET=
#
# 方式 B · 企业自建应用(可发到指定群/人,卡片按钮支持回调):
#   飞书开放平台 → 企业自建应用 → 启用机器人能力,拿到 App ID / App Secret。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 接收目标 ID:群的 chat_id 或 用户的 open_id(取决于下面的类型)。
# FEISHU_RECEIVE_ID=
# 接收 ID 类型:chat_id(群) | open_id(用户) | user_id | union_id,默认 chat_id。
# FEISHU_RECEIVE_ID_TYPE=chat_id
#
# 验证:`node scripts/verify-feishu.js`(结构部分随时可跑;填好凭据后发真实测试卡片)

# ---------- GitHub(K6 adapter:checkout / commit / push-open-pr) ----------
# 全部走 GitHub REST API + 本地 git,**不依赖 `gh` CLI**(K5 决策)。
#   - checkout / commit → 本地 `git`
#   - push              → `git push` 走 token 内嵌 HTTPS URL(不依赖 SSH / credential helper / gh)
#   - 开 PR             → REST `POST /repos/{o}/{r}/pulls`
#   - merge             → REST `PUT /repos/{o}/{r}/pulls/{n}/merge`(squash)
#
# 只需一个 token:GitHub → 右上角头像 → Settings → 左侧栏最底部 Developer settings →
#   Personal access tokens → Fine-grained tokens → Generate new token
#     - Repository access: Only select repositories → 只选目标仓库(不要 All repositories)
#     - Repository permissions: Contents = Read and write、Pull requests = Read and write
#   把生成的 token(前缀 github_pat_)填到下面。owner/repo 留空会自动从 `git remote get-url origin` 解析。
GITHUB_TOKEN=
# 目标仓库 owner(组织名 / 用户名);留空自动从 git remote 解析(当前仓库 = wintim1143)
# GITHUB_OWNER=
# 目标仓库名;留空自动从 git remote 解析(当前仓库 = pr-agent)
# GITHUB_REPO=
# PR 目标基础分支(默认 main)
# GITHUB_BASE_BRANCH=main
#
# 验证:`node scripts/verify-github.js`(缺失配置会提示去哪获取;齐全则用 REST 做只读探测,不开真实 PR)
#      注意:脚本 require 的是 `dist/`,改完 `src/mastra/adapters/github.ts` 后必须先 `npm run build`。
